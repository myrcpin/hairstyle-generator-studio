# ---- Frontend (public, safe to expose) ----
VITE_APP_NAME=CutCard
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable anon key>
VITE_SUPPORT_EMAIL=support@example.com
VITE_COMPANY_NAME=Your Company Ltd
VITE_COMPANY_ADDRESS=Registered address

# ---- Edge Functions (server-only: set with `supabase secrets set`, NEVER prefix with VITE_) ----
# SITE_URL=https://yourdomain.com
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# APP_NAME=CutCard
# OPENAI_API_KEY=sk-...
# TEXT_MODEL=gpt-5-mini                       (optional override of admin setting)
# IMAGE_MODEL_EXPLORE=gpt-image-2.5-flare     (optional override)
# IMAGE_MODEL_FINAL=gpt-image-2.5-sunburst    (optional override)
# PAYPAL_ENV=sandbox|live
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...
# RESEND_API_KEY=re_...
# EMAIL_FROM="CutCard <cards@yourdomain.com>"
# IP_HASH_SALT=<long random string>
# CRON_SECRET=<long random string>
